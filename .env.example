# Copy to .env.local and fill in. Restart `npm run dev` after any change.
#
# Each OAuth app needs this redirect (callback) URL registered, with the host
# swapped for the real domain in production:
#   Google     http://localhost:3210/api/auth/callback/google
#   Microsoft  http://localhost:3210/api/auth/callback/azure-ad
#   GitHub     http://localhost:3210/api/auth/callback/github

# The address the site is served from.
NEXTAUTH_URL=http://localhost:3210
# Signs the session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
#   Create credentials > OAuth client ID > Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://entra.microsoft.com > App registrations > New registration
#   Platform "Web"; the secret is under Certificates & secrets.
#   Leave the tenant as "common" to accept work, school and personal accounts.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# GitHub: https://github.com/settings/developers > OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
